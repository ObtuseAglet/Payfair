{
  "name": "payfair",
  "version": "0.1.0",
  "description": "Browser extension that flags Pokémon TCG listings sold above MSRP by third-party and marketplace sellers.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "icons": "node scripts/generate-icons.mjs",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.9",
    "wxt": "^0.20.0"
  },
  "pnpm": {
    "overrides": {
      "shell-quote@<1.8.4": ">=1.8.4",
      "tmp@<0.2.6": ">=0.2.6",
      "esbuild@<0.28.1": ">=0.28.1",
      "vite@<8.0.16": ">=8.0.16"
    }
  }
}
